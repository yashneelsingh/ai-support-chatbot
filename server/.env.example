# Server Port (default 5000)
PORT=5000

# MongoDB Atlas connection string for sessions and vector search
# Get this from MongoDB Atlas -> Database -> Connect -> Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<appName>

# PostgreSQL connection string (Neon, Supabase, Railway, etc.)
# Get this from your Postgres provider's dashboard
PG_URI=postgresql://<user>:<password>@<host>/<database>?sslmode=verify-full
PG_DNS_RESULT_ORDER=ipv4first
PG_AUTO_SELECT_FAMILY=false
DB_CONNECTION_TIMEOUT_MS=15000
DB_CONNECTION_RETRIES=3

# JSON Web Token secret for authentication
# Generate a random 256-bit hex string, e.g., using `openssl rand -hex 32`
JWT_SECRET=your_jwt_secret_here

# Google Gemini API Key
# Get this from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional model overrides
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Cloudinary credentials for PDF file uploads
# Get these from Cloudinary Dashboard -> Programmable Media -> Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional: Email credentials for the daily reminder cron job
# E.g., Gmail and a 16-character App Password
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_SERVICE=gmail

# "email" for production. "screen" returns the reset token to the browser and
# must only be used for local demos because possession of an email is not proof of identity.
PASSWORD_RESET_DELIVERY=email

# Client URL(s) for CORS (comma-separated when more than one origin is needed)
CLIENT_URL=http://localhost:8080
